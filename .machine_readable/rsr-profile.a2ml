# Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
#
# rsr-profile.a2ml — this repo's declared RSR v2.0 capabilities.
#
# Authored in the A2ML record dialect (hyperpolymath/standards
# a2ml/RECORD-DIALECT-SPEC.adoc). It declares which capabilities this repo has,
# per TEMPLATE-APPLICABILITY-POLICY.adoc; the RSR v2.0 conformance oracle
# (hypatia Hypatia.Rules.RsrConformance) uses `capabilities` to compute the
# APPLICABLE criteria set — a gated criterion is scored only when its gating
# capability appears below; everything else is `na` and excluded from the
# denominator.
#
# authority-watch is a legal/regulatory change monitoring system with a
# strictly-controlled pipeline for tracking authoritative documents. It
# enforces a non-bypassable progression of review states before any document
# can be treated as authoritative.
#
# Architecture note: FFI layer is PURE ZIG (no C), ABI layer is PURE IDRIS2.
# The ABI adapter for estate integration is `zig-unified-hexadeca-adapter` (NOT
# `unified-hexadeca-api`). The zig api adapter is in hyperpolymath estate.
# See docs/architecture/estate-reconnaissance.adoc for details.

[rsr-profile]
version = "1.0.0"
spec = "rsr-criteria-v2"
declares-against = "2.0.0-draft"
# Effective capability set for authority-watch.
# The repo uses:
# - Zig for FFI (pure Zig, NO C FFI)
# - Idris2 for ABI (pure Idris2, formal type definitions)
# - AffineScript for application contracts
# It is currently a CLI tool and library with formal proofs,
# but no container, docs site, or benchmarks.
# The ABI adapter is `zig-unified-hexadeca-adapter` (hyperpolymath estate).
capabilities = [
  "zig",                # zig/src/ - CLI executable, core hashing/ingestion, PURE ZIG FFI (NO C)
  "idris2",             # idris2/AuthorityWatch/ - formal domain model, invariants, PURE IDRIS2 ABI (NO C)
  "ffi",                # PURE ZIG FFI - zig/src/ implements FFI directly, no C intermediary
  "abi",                # PURE IDRIS2 ABI - idris2/AuthorityWatch/ defines ABI at type level, no C intermediary
  "affinescript",       # affinescript/ - application contracts for domain and review
  "bash",               # tools/check-prohibited-stack.sh + Justfile tasks
  "cli",                # authority-watch executable with status/freshness/ingest commands
  "library",            # authority_watch Zig module - core types and functions
  "formal-proofs",      # Idris2 type-level invariants for review states and activation
  "governance-tier",    # full GOVERNANCE.adoc + AGENTS.md + dependency policies
]

[notes]
# Capabilities declared ABOVE are present in this tree:
#   ffi                - PURE ZIG FFI: zig/src/ implements FFI directly, NO C intermediary
#   abi                - PURE IDRIS2 ABI: idris2/AuthorityWatch/ defines ABI at type level, NO C intermediary
#
# Capabilities intentionally NOT declared (no corresponding code in tree):
#   container          - No container/Containerfile or .devcontainer/
#   reproducible-build - No build/guix.scm or stapeln configuration
#   benchmarks        - No benches/ directory
#   docs-site          - No docs site generation or GitHub Pages workflow
#   published-package  - Not published as a registry artifact
#   mobile             - No mobile app
#   web-ui             - No browser UI
#   api-service        - Not a network daemon
#
# ESTATE INTEGRATION CLARIFICATION:
#   The estate ABI adapter is `zig-unified-hexadeca-adapter` in hyperpolymath estate.
#   This is NOT the same as `unified-hexadeca-api` (which is BLOCKED - no canonical repository).
#   Neither `zig-unified-hexadeca-adapter` nor `unified-hexadeca-api` are in rsr-template-repo.
#   They are in the hyperpolymath standards repo or other hyperpolymath estate repos.
#   See docs/architecture/estate-reconnaissance.adoc for full details.
#
# BLOCKED: unified-hexadeca-api - NO CANONICAL REPOSITORY LOCATED.
# Do not confuse with `zig-unified-hexadeca-adapter` which is the correct estate adapter.
omitted-rationale = "Declaring a capability this repo lacks would make the oracle score it against a module it does not carry — the over-scaffolding failure v2.0 fixes. See TEMPLATE-APPLICABILITY-POLICY.adoc."
