enum TransitionDecision {
  Allowed,
  RejectedSkip,
  RequiresSpecialist,
  RequiresSecondReviewer
}

struct TransitionRequest {
  fromState: String,
  toState: String,
  reviewerCount: Int,
  production: Bool
}

fn productionApprovalGate(request: ref TransitionRequest) -> TransitionDecision {
  if request.production {
    if request.reviewerCount >= 2 {
      Allowed
    } else {
      RequiresSecondReviewer
    }
  } else {
    Allowed
  }
}
